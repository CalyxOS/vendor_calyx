# This file is updated manually based on Android changes, especially for including new
# core signing keys, APEXes, and APEX APKs.
# Key re-mapping is not covered in this file.
# IMPORTANT: PLEASE PRESERVE THE ORDER OF THESE ARRAYS, AS MAPPINGS TO KEY IDS MAY DEPEND ON IT.

# Android Verified Boot (AVB) partitions that can be signed with their own independent keys.
# RSA algorithm is required for AVB signing.
# vbmeta can never be rotated.
# PLEASE PRESERVE THE ORDER OF THIS ARRAY, ADDING NEW ITEMS AT THE BOTTOM.
# DO NOT REMOVE ITEMS. IF NECESSARY, REPLACE WITH: ""
keys_avb=(
  vbmeta
  boot
  dtbo
  init_boot
  recovery
  system
  system_other
  vendor
  vbmeta_system
  vbmeta_vendor
)

# Standalone key types that do not belong in the other categories.
keys_other=(
  # Although Android can accept multiple OTA certs for a release, a given release
  # is signed with just one by design. We have an array for this to match the layout
  # of other keys. This key was once the "release key" or releasekey, which doubled as
  # the default signing key for apps, replacing testkey/devkey. However, given that
  # the key used for OTA updates is a distinct key, we treat it as such today.
  ota
)

# Core signing keys. Used by SELinuxMMAC to determine permissions. Each must be unique.
# PLEASE PRESERVE THE ORDER OF THIS ARRAY, ADDING NEW ITEMS AT THE BOTTOM.
# DO NOT REMOVE ITEMS. IF NECESSARY, REPLACE WITH: ""
keys_core=(
  # testkey is the default signing key. This is not necessarily the OTA key. See keys_other.
  build/make/target/product/security/testkey
  build/make/target/product/security/media
  build/make/target/product/security/shared
  build/make/target/product/security/platform
  build/make/target/product/security/networkstack
  build/make/target/product/security/bluetooth
  build/make/target/product/security/sdk_sandbox
  build/make/target/product/security/nfc
)

# APEXes, each of which has a container and payload.
