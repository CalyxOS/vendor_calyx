# The signing metadata lives in metadata.py. Sourcing this file defines it as Bash arrays.

_metadata_path=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P) || return $?
_metadata_declarations=$(python3 -I - "$_metadata_path/metadata.py" <<'EOF'
import runpy
import shlex
import sys

metadata = runpy.run_path(sys.argv[1])
for name in (
    "keys_avb",
    "keys_other",
    "keys_core",
    "keys_apex",
    "keys_apex_apk",
    "keys_app",
    "keys_repo",
    "key_types",
    "mapped_key_types",
    "all_devices",
):
    values = metadata[name.upper()]
    if not isinstance(values, tuple) or not all(
        isinstance(value, str) for value in values
    ):
        sys.exit(f"{name.upper()} in {sys.argv[1]} is not a tuple of strings")
    print(f"{name}=(")
    for value in values:
        print(f"  {shlex.quote(value)}")
    print(")")
    if name == "key_types":
        mapping = metadata["KEY_TYPE_TO_ARRAY"]
        if not isinstance(mapping, dict) or not all(
            isinstance(key, str) and isinstance(value, str)
            for key, value in mapping.items()
        ):
            sys.exit(
                f"KEY_TYPE_TO_ARRAY in {sys.argv[1]} does not map strings "
                "to strings"
            )
        print("declare -g -A key_type_to_array=(")
        for key_type, array in mapping.items():
            print(f"  [{shlex.quote(key_type)}]={shlex.quote(array)}")
        print(")")
EOF
) || {
  echo "error: cannot load $_metadata_path/metadata.py" >&2
  return 1
}
eval "$_metadata_declarations"
unset _metadata_path _metadata_declarations
